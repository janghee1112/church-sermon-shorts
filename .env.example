OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_ANALYSIS_MODEL=gpt-4.1-mini
USE_MOCK_AI=true
APP_ENV=development
MAX_UPLOAD_SIZE_MB=2048
MAX_VIDEO_DURATION_MINUTES=90
DATA_DIR=.
UPLOAD_DIR=./uploads
PROCESSED_DIR=./processed
DATABASE_URL=sqlite:///./sermon_shorts.db
CORS_ORIGINS=http://localhost:3000
FRONTEND_PROXY_URL=
AUDIO_CHUNK_MINUTES=20
AUDIO_CHUNK_OVERLAP_SECONDS=2
RENDER_WIDTH=1080
RENDER_HEIGHT=1920
RENDER_FPS=30
RENDER_CRF=20
RENDER_PRESET=medium
TITLE_FONT_PATH=./backend/assets/fonts/Pretendard-Black.otf
SUBTITLE_FONT_PATH=./backend/assets/fonts/NanumMyeongjo-Regular.ttf
TITLE_FONT_NAME="Pretendard Black"
SUBTITLE_FONT_NAME=NanumMyeongjo
STORAGE_BACKEND=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sermon-shorts
R2_ENDPOINT_URL=
R2_REGION=auto
R2_MULTIPART_PART_SIZE_MB=25
R2_UPLOAD_URL_EXPIRY_SECONDS=14400
R2_READ_URL_EXPIRY_SECONDS=14400
R2_CORS_ORIGINS=http://localhost:3000,https://church-sermon-shorts-production.up.railway.app
